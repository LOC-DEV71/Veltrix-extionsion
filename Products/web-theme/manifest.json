{
  "manifest_version": 3,
  "name": "Veltrix Theme",
  "version": "1.6.1",
  "description": "Đổi màu giao diện YouTube, Facebook và Google Tìm kiếm theo bộ theme có sẵn hoặc màu nhấn tùy chọn.",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Veltrix Theme",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.facebook.com/*",
        "*://www.google.com/*",
        "*://www.google.com.vn/*"
      ],
      "js": [
        "themes.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "bg.html"
      ],
      "matches": [
        "*://*.youtube.com/*",
        "*://*.facebook.com/*",
        "*://www.google.com/*",
        "*://www.google.com.vn/*"
      ]
    }
  ],
  "homepage_url": "https://extension.veltrixhost.cloud",
  "author": "Veltrix Store",
  "background": {
    "service_worker": "sw.js"
  }
}